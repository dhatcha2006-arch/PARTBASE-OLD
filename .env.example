# Flask App Configuration
FLASK_APP=wsgi.py
FLASK_ENV=development
SECRET_KEY=localvelai-change-this-in-production-random-secret-key-32chars

# Database Configuration (MySQL main, SQLite fallback if empty or unreachable)
DATABASE_URL=mysql+pymysql://root:password@localhost:3306/localvelai

# Admin Access (comma-separated E.164 phone numbers)
ADMIN_PHONES=+919876500000,+919876543210

# OTP Provider: console (dev/default) | msg91 | twilio
OTP_PROVIDER=console

# Server Port
PORT=5000
